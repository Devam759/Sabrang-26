rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for role checks
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid)) 
        ? get(/databases/$(database)/documents/roles/$(uid)).data.role 
        : (exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)).data.role : null);
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        getRole(request.auth.uid) == 'admin'
      );
    }
    
    function isScanner() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'scanner' ||
        getRole(request.auth.uid) == 'scanner'
      );
    }

    // Users collection (Sabrang user profiles)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isScanner());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) 
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Roles collection rules
    match /roles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Registrations collection
    match /registrations/{id} {
      allow read: if isAdmin() || isScanner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Registrations are created server-side via Admin SDK (bypasses rules)
      allow create: if false;
      allow update: if isAdmin() || (
        isScanner() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasEntered', 'enteredAt', 'scannerId', 'scannerName', 'checkInLogs'])
      );
      allow delete: if isAdmin();
    }

    // Pending Registrations collection (Admin SDK only)
    match /pendingRegistrations/{id} {
      allow read, write: if false;
    }

    // Registration and Background Task Locks (Admin SDK only)
    match /registrationLocks/{id} {
      allow read, write: if false;
    }

    match /backgroundTaskLocks/{id} {
      allow read, write: if false;
    }

    match /processedWebhookEvents/{id} {
      allow read, write: if false;
    }

    match /webhookLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications/Announcements collections
    match /notifications/{id} {
      allow read, update, delete: if isSignedIn();
      allow create: if isSignedIn() && isAdmin();
    }
    
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scan logs collection
    match /scanLogs/{id} {
      allow read: if isAdmin() || isScanner();
      allow write: if isAdmin() || isScanner();
    }

    // Entry logs collection
    match /entryLogs/{id} {
      allow read, write: if isAdmin() || isScanner();
    }

    // System Errors collection
    match /systemErrors/{id} {
      allow read, write: if isAdmin();
    }

    // Referrals collection
    match /referrals/{id} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    // Events (public schedule)
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs collection
    match /auditLogs/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    // Feedback collection
    match /feedback/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Complaints collection
    match /complaints/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Suggestions collection
    match /suggestions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings (e.g. active day settings)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scanner Accounts collection
    match /scannerAccounts/{id} {
      allow read: if isSignedIn() && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
    }

    // Coupons collection
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact Messages collection
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
